{
  "name": "tellus",
  "version": "0.1.0",
  "private": true,
  "description": "Une planète entière simulée tick par tick.",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm build:sim && electron-vite dev",
    "build": "pnpm build:sim && electron-vite build",
    "build:sim": "napi build --manifest-path simulation/Cargo.toml --features node --release --output-dir out/native",
    "lint": "eslint .",
    "typecheck": "tsc -p desktop/tsconfig.json && tsc -p interface/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "test": "vitest",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "framer-motion": "14.9.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/cli": "3.10.9",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
